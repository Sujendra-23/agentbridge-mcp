# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# --- LLM backend -------------------------------------------------------
# Primary: OpenAI. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=XXX_KEY_HERE
OPENAI_MODEL=gpt-5

# Optional: point at an OpenAI-compatible endpoint instead of OpenAI itself,
# e.g. NVIDIA NIM's free tier (https://build.nvidia.com). Leave blank to use
# OpenAI directly. If set, OPENAI_API_KEY should hold the NIM key instead.
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=nvidia/nemotron-3-ultra

# --- MCP servers ---------------------------------------------------------
# Tavily Search MCP server. Free tier: https://app.tavily.com
TAVILY_API_KEY=XXX_KEY_HERE

# Root directory the filesystem MCP server is allowed to read/write.
# Inside the container this is baked to /app/mcp_workspace (see Dockerfile).
MCP_FILESYSTEM_ROOT=./mcp_workspace

# Path to the MCP server manifest the agent reads at startup.
MCP_SERVERS_CONFIG=./mcp_config.json

# --- Deployment ------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id

# Cloud Run injects PORT itself; this default is only used for local runs.
PORT=8080
